{
  "name": "@peak-empire/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @peak-empire/shared-types --filter @peak-empire/sheets-client --filter @peak-empire/lead-sourcing --filter @peak-empire/scoring run build && pnpm run typecheck && pnpm run bundle && node scripts/write-deploy-package.mjs",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/* --external:googleapis --external:googleapis/*",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "deploy": "pnpm build && firebase deploy --only functions",
    "test": "vitest run"
  },
  "dependencies": {
    "@peak-empire/shared-types": "workspace:*",
    "@peak-empire/sheets-client": "workspace:*",
    "@peak-empire/lead-sourcing": "workspace:*",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^144.0.0",
    "@peak-empire/scoring": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "esbuild": "^0.24.0"
  }
}