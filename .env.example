# Copy to .env and fill in. Never commit the real .env.

# The Google Sheet acting as the database (from its URL).
SHEET_ID=

# Service account JSON (single line) with edit access to the sheet above.
# Create in Google Cloud Console > IAM > Service Accounts, share the Sheet
# with its email address, then paste the downloaded key JSON here as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Discovery sources
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Enrichment (optional, called on-demand only)
APOLLO_API_KEY=

# Cold email (optional -- resend.com free tier is generous for this volume)
RESEND_API_KEY=
FROM_EMAIL=

# Used by web/ to reach the deployed Functions.
VITE_FUNCTIONS_BASE_URL=https://us-central1-your-project.cloudfunctions.net
